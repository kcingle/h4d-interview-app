# Copy this file to .streamlit/secrets.toml (same folder) and fill in real
# values. secrets.toml itself is gitignored — never commit real secrets.
#
# For local testing against Postgres: only DATABASE_URL is required by
# storage.py. ANTHROPIC_API_KEY and TEAM_PASSWORD are used once Phase 3
# (deploy) wires up server-side key handling and the password gate — set
# them now if you want to test those early, or leave them out for now.

DATABASE_URL = "postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# ANTHROPIC_API_KEY = "sk-ant-..."
# TEAM_PASSWORD = "choose-a-shared-team-password"
