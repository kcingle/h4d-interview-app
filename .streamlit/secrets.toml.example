# Copy this file to .streamlit/secrets.toml (same folder) and fill in real
# values. secrets.toml itself is gitignored — never commit real secrets.
#
# DATABASE_URL is required (storage.py's Neon/Postgres connection).
# TEAM_PASSWORD is required to get past the login gate (auth.py) — every
# page refuses to render anything until this is entered correctly.
# ANTHROPIC_API_KEY is optional locally (env_store.py falls back to a
# local .env file and an editable Settings-page box when this isn't
# set) but should be set here — server-side only — once deployed, so the
# key never lives on anyone's laptop or in the repo.

DATABASE_URL = "postgresql://<user>:<password>@<host>/<database>?sslmode=require"
TEAM_PASSWORD = "choose-a-shared-team-password"

# ANTHROPIC_API_KEY = "sk-ant-..."
